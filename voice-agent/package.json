{
  "name": "@dialy/voice-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Dialy realtime voice worker: LiveKit transport + Sarvam STT/TTS, intelligence delegated to the brain.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/agent.ts dev",
    "start": "node dist/agent.js start",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "token": "tsx src/token-server.ts"
  },
  "dependencies": {
    "@livekit/agents": "^1.9.0",
    "@livekit/agents-plugin-sarvam": "^1.9.0",
    "@livekit/agents-plugin-silero": "^1.9.0",
    "@livekit/rtc-node": "^0.13.34",
    "dotenv": "^16.6.1",
    "livekit-server-sdk": "^2.19.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.18.1",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
