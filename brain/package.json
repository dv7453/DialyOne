{
  "name": "@x/core",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "dev": "tsc -w -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "inspect-turn": "node dist/runtime/turns/inspect-cli.js",
    "inspect": "node dist/runtime/turns/inspect-cli.js",
    "api": "tsc -p tsconfig.api.json && node dist-api/server.js",
    "typecheck:api": "tsc --noEmit -p tsconfig.api.json",
    "start": "BRAIN_HOST=${BRAIN_HOST:-0.0.0.0} node dist/host/main.js",
    "start:lan": "BRAIN_HOST=0.0.0.0 node dist/host/main.js",
    "start:local": "BRAIN_HOST=127.0.0.1 node dist/host/main.js",
    "stress": "node dist/host/stress-cli.js",
    "eval": "npm run build && node dist/eval/cli.js",
    "scenarios": "npm run build && node dist/operator/testing/scenarios-cli.js",
    "watchdog": "node dist/watchdog/main.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@agentclientprotocol/claude-agent-acp": "^0.67.0",
    "@agentclientprotocol/codex-acp": "^1.2.0",
    "@agentclientprotocol/sdk": "^1.3.0",
    "@ai-sdk/anthropic": "^4.0.12",
    "@ai-sdk/google": "^4.0.12",
    "@ai-sdk/openai": "^4.0.11",
    "@ai-sdk/openai-compatible": "^3.0.7",
    "@ai-sdk/provider": "^4.0.3",
    "@composio/core": "^0.6.0",
    "@google-cloud/local-auth": "^3.0.1",
    "@langfuse/otel": "^5.10.1",
    "@langfuse/tracing": "^5.10.1",
    "@modelcontextprotocol/sdk": "^1.25.1",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/sdk-trace-node": "^2.0.1",
    "@openrouter/ai-sdk-provider": "^3.0.0",
    "@react-pdf/renderer": "^4.3.2",
    "@types/react": "^19.2.7",
    "@x/shared": "workspace:*",
    "@x/spaces-protocol": "workspace:*",
    "ai": "^7.0.22",
    "awilix": "^12.0.5",
    "baileys": "7.0.0-rc13",
    "chokidar": "^4.0.3",
    "cors": "^2.8.6",
    "cron-parser": "^5.5.0",
    "drizzle-orm": "^0.45.2",
    "express": "^5.2.1",
    "glob": "^13.0.0",
    "google-auth-library": "^10.5.0",
    "googleapis": "^169.0.0",
    "isomorphic-git": "^1.29.0",
    "livekit-server-sdk": "^2.19.1",
    "mammoth": "^1.11.0",
    "node-html-markdown": "^2.0.0",
    "ollama-ai-provider-v2": "^4.0.1",
    "openid-client": "^6.8.1",
    "papaparse": "^5.5.3",
    "pdf-parse": "^2.4.5",
    "postgres": "^3.4.9",
    "posthog-node": "^4.18.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.3",
    "xlsx": "^0.18.5",
    "yaml": "^2.8.2",
    "yauzl": "^3.4.0",
    "yazl": "^3.3.1",
    "zod": "4.2.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^25.0.3",
    "@types/papaparse": "^5.5.2",
    "@types/pdf-parse": "^1.1.5",
    "@types/qrcode": "^1.5.6",
    "@types/yauzl": "^3.4.0",
    "@types/yazl": "^3.3.1",
    "drizzle-kit": "^0.31.10",
    "typescript": "^5.9.3",
    "vitest": "catalog:"
  }
}
