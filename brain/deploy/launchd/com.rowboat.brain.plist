<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  LEGACY — prefer: bash brain/deploy/install-launchd.sh
  (installs com.dialy.brain with absolute node path).

  KeepAlive restarts on crash. Pair with caffeinate (see deploy/README.md).
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.rowboat.brain</string>
  <key>WorkingDirectory</key>
  <string>/Users/REPLACE/Downloads/rowboat-main/brain</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/env</string>
    <string>node</string>
    <string>dist/host/main.js</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>BRAIN_HOST</key>
    <string>0.0.0.0</string>
    <key>BRAIN_PORT</key>
    <string>8787</string>
    <!-- Optional: <key>BRAIN_TOKEN</key><string>change-me</string> -->
  </dict>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>StandardOutPath</key>
  <string>/Users/REPLACE/.rowboat/logs/brain.launchd.out.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/REPLACE/.rowboat/logs/brain.launchd.err.log</string>
</dict>
</plist>
